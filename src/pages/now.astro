---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Now — David Melesse" description="What David Melesse is doing right now — Summer 2026.">

  <header class="page-header">
    <nav class="page-nav">
      <a href="/" class="logo">DM</a>
      <div class="nav-links">
        <a href="/projects">work</a>
        <a href="/blog">writing</a>
        <a href="/now" class="active">now</a>
      </div>
    </nav>
  </header>

  <main>

    <section class="hero-section">
      <div class="inner">
        <div class="eth-stripe" role="img" aria-label="Ethiopian flag colors">
          <div class="s-green"></div>
          <div class="s-gold"></div>
          <div class="s-red"></div>
        </div>
        <div class="status-pill">
          <span class="now-dot" aria-hidden="true"></span>
          <span class="status-text">Summer 2026</span>
        </div>
        <p class="page-lede">right now, specifically.</p>
        <h1 class="page-title">now</h1>
      </div>
    </section>


    <section class="now-body section-light">
      <div class="inner now-grid">

        <!-- Left: the current -->
        <div class="now-main">

          <div class="now-block">
            <span class="eyebrow eyebrow-crimson">building</span>
            <h2>LittleLamb Nannies</h2>
            <p>co-founding a nanny placement service for families in Santa Barbara. this summer is the shipping window — everything we've designed needs to become something real people can use. we're building onboarding flows, matching logic, and the trust layer underneath it all.</p>
            <p>target: launched before September.</p>
          </div>

          <div class="now-block">
            <span class="eyebrow eyebrow-gold">working</span>
            <h2>interning at CATLab</h2>
            <p>Westmont's applied tech lab. i'm in an SDR role — donor outreach, cold calls, Salesforce, real conversations with real people about why faith and technology belong together. more educational than i expected. you learn a lot about communication when you can't hide behind a screen.</p>
          </div>

          <div class="now-block">
            <span class="eyebrow eyebrow-gold">writing</span>
            <h2>free writing</h2>
            <p>this isn't anything ground-breaking, just honest thoughts. i want to improve my writing ability, through personal experiences mixed with things of interest. still actively learning, so if you find anything you like, dislike, or have questions about -> reach out!!!</p>
            <a href="/blog" class="block-link">read the early thinking →</a>
          </div>

        </div>

        <!-- Right: the smaller things -->
        <div class="now-aside">

          <div class="aside-block">
            <span class="aside-label">Reading</span>
            <p class="aside-note">whatever looks interesting</p>
          </div>

          <div class="aside-block">
            <span class="aside-label">Drinking</span>
            <p class="aside-note">water + caffeine</p>
          </div>

          <div class="aside-block">
            <span class="aside-label">Based in</span>
            <p class="aside-note">Santa Barbara, CA</p>
          </div>

          <div class="aside-block">
            <span class="aside-label">studying</span>
            <div class="studying-brace">
              <ul class="studying-list">
                <li>computer science</li>
                <li>data analytics</li>
                <li>philosophy</li>
              </ul>
              <div class="brace-group">
                <div class="vert-line"></div>
                <span class="brace-label">@ Westmont '27</span>
              </div>
            </div>
          </div>

          <div class="aside-block">
            <span class="aside-label">Thinking about</span>
            <p class="aside-note">what AI says about being human. whether machines can be creative. the difference between intelligence and personhood.</p>
          </div>

          <div class="aside-block aside-block-contact">
            <span class="aside-label">if you want to talk</span>
            <a href="mailto:melesse.david11@gmail.com" class="contact-link">melesse.david11@gmail.com</a>
            <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer" class="contact-link">LinkedIn</a>
          </div>

          <p class="now-updated">Last updated June 2026. Inspired by <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">nownownow.com</a>.</p>

        </div>

      </div>
    </section>


    <footer class="footer">
      <div class="inner footer-inner">
        <div class="footer-id">
          <span class="footer-name">David Melesse</span>
          <span class="footer-meta">Westmont College · Class of 2027</span>
        </div>
        <div class="footer-links">
          <a href="mailto:melesse.david11@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="inner footer-bottom">
        <span>Built by David Melesse · 2026</span>
      </div>
    </footer>

  </main>

</Layout>


<style>
  /* ── HEADER ── */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--espresso);
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
  }
  .page-nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .logo:hover { color: var(--gold); }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.4;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }
  .nav-links a:hover, .nav-links a.active { opacity: 1; }

  /* ── HERO ── */
  .hero-section {
    background: var(--espresso);
    padding: 5rem 2.5rem 4rem;
  }
  .inner { max-width: var(--max-width); margin: 0 auto; }

  .eth-stripe {
    display: flex;
    gap: 3px;
    width: 50px;
    margin-bottom: 1.75rem;
  }
  .eth-stripe > div { height: 3px; flex: 1; border-radius: 2px; }
  .s-green { background: var(--eth-green); }
  .s-gold  { background: var(--eth-gold); }
  .s-red   { background: var(--eth-red); }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: var(--dark-roast);
    border: 1px solid rgba(200, 137, 58, 0.18);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    margin-bottom: 1.75rem;
  }
  .now-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #3EA55A;
    box-shadow: 0 0 0 2px rgba(62, 165, 90, 0.28);
    animation: pulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(62, 165, 90, 0.28); }
    50%       { box-shadow: 0 0 0 6px rgba(62, 165, 90, 0.06); }
  }
  .status-text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-lede {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-muted-dark);
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    color: var(--text-on-dark);
    line-height: 1.05;
  }

  /* ── NOW BODY ── */
  .section-light { background: var(--cream); }
  .now-body { padding: 6rem 2.5rem; }

  .now-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 6rem;
    align-items: start;
  }

  /* Main blocks */
  .now-main { display: flex; flex-direction: column; gap: 4rem; }
  .now-block {}

  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .eyebrow-crimson { color: var(--crimson); }
  .eyebrow-gold    { color: var(--gold); }

  .now-block h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-on-light);
    line-height: 1.15;
    margin-bottom: 1rem;
  }
  .now-block p {
    font-size: 1rem;
    color: var(--text-muted-light);
    line-height: 1.85;
    margin-bottom: 0.875rem;
  }
  .now-block p:last-of-type { margin-bottom: 0; }

  .block-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gold);
    border-bottom: 1px solid rgba(200, 137, 58, 0.3);
    padding-bottom: 3px;
    transition: border-color 0.2s;
  }
  .block-link:hover { border-color: var(--gold); }

  /* Aside */
  .now-aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 6rem;
  }

  .aside-block {
    border-top: 1px solid rgba(30, 16, 10, 0.1);
    padding-top: 1.25rem;
  }
  .aside-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted-light);
    margin-bottom: 0.625rem;
  }
  .aside-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .aside-list li {
    font-size: 0.9375rem;
    color: var(--text-on-light);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .aside-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 0.75rem;
  }
  .aside-note {
    font-size: 0.9375rem;
    color: var(--text-on-light);
    line-height: 1.6;
  }
  .aside-block-contact { display: flex; flex-direction: column; gap: 0.5rem; }

  .studying-brace {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }
  .studying-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .studying-list li {
    font-size: 0.9375rem;
    color: var(--text-on-light);
    line-height: 1.5;
  }
  .brace-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.375rem;
    align-self: stretch;
  }
  .vert-line {
    width: 1.5px;
    flex-shrink: 0;
    align-self: stretch;
    background: var(--text-on-light);
    border-radius: 2px;
  }
  .brace-label {
    font-size: 0.9375rem;
    color: var(--text-on-light);
    white-space: nowrap;
  }
  .contact-link {
    font-size: 0.9375rem;
    color: var(--gold);
    transition: opacity 0.2s;
  }
  .contact-link:hover { opacity: 0.7; }

  .now-updated {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted-light);
    opacity: 0.6;
    line-height: 1.6;
    border-top: 1px solid rgba(30, 16, 10, 0.1);
    padding-top: 1.25rem;
  }
  .now-updated a { color: inherit; border-bottom: 1px solid currentColor; }

  /* ── FOOTER ── */
  .footer {
    background: var(--espresso);
    border-top: 1px solid rgba(240, 232, 216, 0.07);
    padding: 3rem 2.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
    margin-bottom: 1.5rem;
  }
  .footer-id { display: flex; flex-direction: column; gap: 0.3rem; }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
  }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cream); }
  .footer-bottom {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(240, 232, 216, 0.2);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .now-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .now-aside { position: static; }
  }
  @media (max-width: 640px) {
    .hero-section { padding: 3.5rem 1.5rem 3rem; }
    .now-body { padding: 4rem 1.5rem; }
    .page-nav { padding: 1rem 1.5rem; }
    .footer-inner { flex-direction: column; gap: 1.5rem; }
  }
</style>
