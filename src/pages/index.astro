---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="David Melesse">

  <!-- ═══════ HERO — type-led, portrait on the side ═══════ -->
  <section class="hero">

    <!-- Top bar -->
    <div class="hero-top">
      <a href="/" class="logo" aria-label="Home">DM</a>
      <nav class="hero-nav" aria-label="Main navigation">
        <a href="/projects">Work</a>
        <a href="/blog">Writing</a>
        <a href="/now">Now</a>
      </nav>
    </div>

    <!-- Main content -->
    <div class="hero-main">

      <div class="hero-copy">
        <!-- Ethiopian stripe — the mark -->
        <div class="eth-stripe" role="img" aria-label="Ethiopian flag colors">
          <div class="s-green"></div>
          <div class="s-gold"></div>
          <div class="s-red"></div>
        </div>

        <p class="hero-hi">Hi.</p>
        <h1 class="hero-name">I'm David Melesse.</h1>

        <ul class="hero-studying-list">
          <li>Computer science</li>
          <li>Data analytics</li>
          <li>Philosophy</li>
        </ul>

        <p class="hero-guide">If you're curious about the thinking — start with the writing.</p>

        <div class="hero-cta">
          <a href="/projects" class="cta-primary">The work →</a>
          <a href="/blog" class="cta-ghost">The writing →</a>
        </div>
      </div>

      <aside class="hero-side">
        <figure class="hero-portrait">
          <img
            src="/david.jpg"
            alt="David Melesse"
            width="900"
            height="1200"
          />
        </figure>

        <!-- Status card -->
        <div class="now-card">
          <span class="now-dot" aria-hidden="true"></span>
          <span class="now-label">Summer 2026</span>
          <p class="now-text">Shipping LittleLamb. Interning at CATLab. Free writing.</p>
        </div>
      </aside>

    </div>

    <!-- Scroll cue -->
    <div class="hero-scroll" aria-hidden="true">
      <span>scroll</span>
      <span class="scroll-arrow">↓</span>
    </div>

  </section>


  <!-- ═══════ BUILDING ═══════ -->
  <section class="section section-light">
    <div class="inner">
      <p class="section-lede">The things keeping me busy.</p>
      <span class="eyebrow eyebrow-crimson">Currently building</span>
      <div class="project-grid">

        <a href="/projects" class="card card-featured">
          <div class="card-img card-img-plain"></div>
          <div class="card-body">
            <span class="tag tag-crimson">Startup · React + Firebase</span>
            <h3>LittleLamb Nannies</h3>
            <p>Nanny placement for families in Santa Barbara. Values-aligned matching. Built with care.</p>
            <span class="card-link">View project →</span>
          </div>
        </a>

        <div class="card-stack">
          <a href="/projects" class="card card-sm">
            <span class="tag tag-crimson">Internship</span>
            <h3>CATLab SDR</h3>
            <p>Outreach and donor relations at Westmont's applied tech lab. Cold calls, Salesforce, real relationships.</p>
            <span class="card-link">Learn more →</span>
          </a>
          <a href="/blog" class="card card-sm card-dark">
            <span class="tag tag-gold">Writing</span>
            <h3>Thoughts</h3>
            <p>Most of this isn't certain, just thoughts on things of interest. I hope that if you read something you like, dislike, or are questioning you'll reach out!!!</p>
            <span class="card-link card-link-dark">Read the thinking →</span>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════ WRITING ═══════ -->
  <section class="section section-dark">
    <div class="inner">
      <p class="writing-lede">If you want to know how I think, this is the place.</p>
      <div class="writing-head">
        <span class="eyebrow eyebrow-gold">Latest writing</span>
        <a href="/blog" class="see-all">All posts →</a>
      </div>
      <div class="writing-grid">

        <a href="/blog" class="fallai-card">
          <img src="/book.png" alt="The Fall of AI" class="fallai-img" />
          <div class="fallai-overlay" aria-hidden="true"></div>
          <div class="fallai-text">
            <h3 class="fallai-title">The Fall of AI</h3>
            <span class="fallai-link">Read the thinking →</span>
          </div>
        </a>

        <a href="/blog/sneak-peak" class="sneak-card">
          <div class="sneak-img">
            <img src="/fall-of-ai-cover.png" alt="The Fall of AI — Sneak Peak" class="sneak-img-full" />
            <div class="sneak-overlay"></div>
          </div>
          <div class="sneak-label">
            <span class="sneak-eyebrow">Sneak peak</span>
          </div>
        </a>

      </div>
    </div>
  </section>


  <!-- ═══════ NOW ═══════ -->
  <section class="section section-medium">
    <div class="inner">
      <div class="quote-block">
        <span class="eyebrow eyebrow-gold">Right now, specifically</span>
        <blockquote>Concept → execution.</blockquote>
        <p class="quote-sub">
          Shipping LittleLamb. Interning at CATLab. Free writing.
        </p>
        <a href="/now" class="now-full-link">The full picture →</a>
      </div>
    </div>
  </section>


  <!-- ═══════ FOOTER ═══════ -->
  <footer class="footer">
    <div class="inner footer-inner">
      <div class="footer-id">
        <span class="footer-name">David Melesse</span>
        <span class="footer-meta">Westmont College · Class of 2027</span>
      </div>
      <div class="footer-links">
        <a href="mailto:melesse.david11@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
    <div class="inner footer-bottom">
      <span>Built by David Melesse ... (and Claude Code) · 2026</span>
    </div>
  </footer>

</Layout>


<style>
  /* ── HERO — type leads, photo supports, next section peeks below ── */
  .hero {
    /* 88svh leaves the top of the next section visible in the first viewport */
    min-height: 88vh;
    min-height: 88svh;
    background: var(--espresso);
    display: flex;
    flex-direction: column;
    padding: 2rem 3rem 1.5rem;
    position: relative;
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .logo:hover { color: var(--gold); }

  .hero-nav { display: flex; gap: 2rem; }
  .hero-nav a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted-dark);
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }
  .hero-nav a:hover { color: var(--cream); }

  /* Main: copy dominates, portrait sits aside */
  .hero-main {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 0;
  }

  .hero-copy { display: flex; flex-direction: column; }

  /* Ethiopian stripe */
  .eth-stripe {
    display: flex;
    gap: 3px;
    width: 50px;
    margin-bottom: 1.75rem;
  }
  .eth-stripe > div { height: 3px; flex: 1; border-radius: 2px; }
  .s-green { background: var(--eth-green); }
  .s-gold  { background: var(--eth-gold); }
  .s-red   { background: var(--eth-red); }

  .hero-hi {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-style: italic;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 0.375rem;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: var(--cream);
    line-height: 1.2;
    margin-bottom: 0;
  }

  .hero-studying-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .hero-studying-list li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted-dark);
    letter-spacing: 0.04em;
  }

  .hero-guide {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted-dark);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 34ch;
  }

  /* CTAs */
  .hero-cta { display: flex; align-items: center; gap: 2rem; }
  .cta-primary {
    font-size: 1rem;
    font-weight: 500;
    color: var(--gold);
    border-bottom: 1px solid rgba(200, 137, 58, 0.35);
    padding-bottom: 3px;
    transition: border-color 0.2s;
  }
  .cta-primary:hover { border-color: var(--gold); }
  .cta-ghost {
    font-size: 1rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .cta-ghost:hover { color: var(--text-on-dark); }

  /* Portrait — contained, not a half-screen panel */
  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: clamp(200px, 24vw, 300px);
  }
  .hero-portrait {
    margin: 0;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(200, 137, 58, 0.25);
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 8%;
    filter: sepia(0.06) saturate(1.05);
  }

  /* Status card */
  .now-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--dark-roast);
    border: 1px solid rgba(200, 137, 58, 0.18);
    border-radius: 8px;
    padding: 0.875rem 1.125rem;
  }
  .now-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #3EA55A;
    box-shadow: 0 0 0 2px rgba(62, 165, 90, 0.28);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(62, 165, 90, 0.28); }
    50%       { box-shadow: 0 0 0 6px rgba(62, 165, 90, 0.06); }
  }
  .now-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .now-text {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    line-height: 1.55;
  }

  /* Scroll cue */
  .hero-scroll {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint-dark);
    padding-bottom: 0.5rem;
  }
  .scroll-arrow {
    display: inline-block;
    animation: drift 2s ease-in-out infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }

  /* ── SECTIONS ── */
  .section { padding: 6rem 2.5rem; }
  .inner { max-width: var(--max-width); margin: 0 auto; }
  .section-light  { background: var(--cream);        color: var(--text-on-light); }
  .section-dark   { background: var(--espresso);     color: var(--text-on-dark); }
  .section-medium { background: var(--medium-roast); color: var(--text-on-dark); }

  /* Conversational intros */
  .section-lede {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    color: var(--text-muted-light);
    margin-bottom: 0.5rem;
  }
  .writing-lede {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--text-muted-dark);
    max-width: 480px;
    line-height: 1.4;
    margin-bottom: 2rem;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }
  .eyebrow-crimson { color: var(--crimson); }
  .eyebrow-gold    { color: var(--gold); }

  /* ── PROJECT GRID ── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .card {
    display: block;
    border-radius: 12px;
    border: 1px solid rgba(30, 16, 10, 0.1);
    background: var(--cream-card);
    transition: transform 0.25s ease, border-color 0.25s ease;
    overflow: hidden;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(200, 137, 58, 0.4);
  }
  .card-featured { display: flex; flex-direction: column; }
  .card-img {
    height: 200px;
    background: linear-gradient(145deg, #2C180F 0%, #1A0F0A 55%, #3A200F 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .card-img-plain {
    background: linear-gradient(145deg, #2C180F 0%, #1A0F0A 55%, #3A200F 100%);
  }
  .card-body { padding: 1.75rem; }
  .card-sm   { padding: 1.75rem; }
  .card-stack { display: flex; flex-direction: column; gap: 1.5rem; }
  .card-dark {
    background: var(--dark-roast);
    border-color: rgba(200, 137, 58, 0.12);
    color: var(--text-on-dark);
  }
  .card-dark:hover { border-color: rgba(200, 137, 58, 0.35); }
  .card-dark h3 { color: var(--text-on-dark); }
  .card-dark p  { color: var(--text-muted-dark); }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .tag-crimson { color: var(--crimson); }
  .tag-gold    { color: var(--gold-light); }

  .card h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-on-light);
    margin-bottom: 0.5rem;
  }
  .card p {
    font-size: 0.9375rem;
    color: var(--text-muted-light);
    line-height: 1.7;
  }
  .card-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gold-deep);
    transition: opacity 0.2s;
  }
  .card-link-dark { color: var(--gold); }
  .card:hover .card-link { opacity: 0.75; }

  /* ── WRITING ── */
  .writing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .writing-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .writing-head .eyebrow-gold { margin-bottom: 0; }
  .see-all {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gold);
    transition: color 0.2s;
  }
  .see-all:hover { color: var(--gold-light); }

  /* ── QUOTE / NOW ── */
  .quote-block { max-width: 600px; }
  .quote-block .eyebrow-gold { margin-bottom: 2rem; }
  blockquote {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-style: italic;
    color: var(--gold-light);
    line-height: 1.2;
    border-left: 2px solid var(--gold);
    border-radius: 0;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .quote-sub {
    font-size: 1.0625rem;
    color: var(--text-muted-dark);
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  .now-full-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gold);
    border-bottom: 1px solid rgba(200, 137, 58, 0.3);
    padding-bottom: 3px;
    transition: border-color 0.2s;
  }
  .now-full-link:hover { border-color: var(--gold); }

  /* ── FOOTER ── */
  .footer {
    background: var(--espresso);
    border-top: 1px solid rgba(240, 232, 216, 0.07);
    padding: 3rem 2.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
    margin-bottom: 1.5rem;
  }
  .footer-id { display: flex; flex-direction: column; gap: 0.3rem; }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted-dark);
  }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cream); }
  .footer-bottom {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint-dark);
  }

  /* ── FALL OF AI CARD ── */
  .fallai-card {
    display: block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(200, 137, 58, 0.12);
    transition: border-color 0.25s ease, transform 0.25s ease;
    min-height: 300px;
  }
  .fallai-card:hover {
    border-color: rgba(200, 137, 58, 0.4);
    transform: translateY(-3px);
  }
  .fallai-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    position: absolute;
    inset: 0;
  }
  .fallai-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17, 10, 6, 0.88) 0%, rgba(17, 10, 6, 0.25) 45%, transparent 100%);
  }
  .fallai-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.75rem;
  }
  .fallai-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--cream);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .fallai-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gold-light);
  }

  /* ── SNEAK PEAK CARD ── */
  .sneak-card {
    display: block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(200, 137, 58, 0.12);
    transition: border-color 0.25s ease, transform 0.25s ease;
    height: 100%;
    min-height: 300px;
  }
  .sneak-card:hover {
    border-color: rgba(200, 137, 58, 0.4);
    transform: translateY(-3px);
  }
  .sneak-img {
    position: absolute;
    inset: 0;
  }
  .sneak-img-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .sneak-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17, 10, 6, 0.85) 0%, rgba(17, 10, 6, 0.2) 50%, transparent 100%);
  }
  .sneak-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.75rem;
  }
  .sneak-eyebrow {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-style: italic;
    color: var(--cream);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero { padding: 1.75rem 2rem 1.25rem; }
    .hero-main {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2rem 0;
    }
    .hero-side {
      width: 100%;
      flex-direction: row;
      align-items: flex-end;
      gap: 1.25rem;
    }
    .hero-portrait { width: clamp(150px, 38vw, 220px); flex-shrink: 0; }
    .now-card { flex: 1; }
    .project-grid { grid-template-columns: 1fr; }
    .writing-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: 1.5rem 1.5rem 1rem; }
    .section   { padding: 4rem 1.5rem; }
    .hero-cta  { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .hero-side { flex-direction: column; align-items: stretch; }
    .hero-portrait { width: clamp(150px, 45vw, 200px); }
    .writing-head { flex-direction: column; gap: 0.75rem; align-items: flex-start; }
    .footer-inner { flex-direction: column; gap: 1.5rem; }
  }
</style>

<script>
  // For people who open DevTools.
  console.log(
    "%c👋 Hey.",
    "font-family: monospace; font-size: 18px; color: #C8893A;"
  );
  console.log(
    "%cSince you opened DevTools, I already respect you.\nAlways down to talk shop. → melesse.david11@gmail.com",
    "font-family: monospace; font-size: 13px; line-height: 1.6; color: #F0E8D8;"
  );
</script>
