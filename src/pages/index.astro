---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="David Melesse">

  <!-- ═══════ HERO — split layout ═══════ -->
  <section class="hero">

    <!-- Photo panel -->
    <div class="hero-photo">
      <div class="logo-float">
        <a href="/" class="logo" aria-label="Home">DM</a>
      </div>
      <img
        src="/david.jpg"
        alt="David Melesse"
        width="900"
        height="1200"
      />
      <!-- Right-edge fade into text panel -->
      <div class="photo-fade" aria-hidden="true"></div>
    </div>

    <!-- Text panel -->
    <div class="hero-text">

      <!-- Nav sits at top of text panel -->
      <nav class="hero-nav" aria-label="Main navigation">
        <a href="/projects">work</a>
        <a href="/blog">writing</a>
        <a href="/now">now</a>
      </nav>

      <!-- Content anchored to bottom -->
      <div class="hero-content">

        <!-- Status card -->
        <div class="now-card">
          <span class="now-dot" aria-hidden="true"></span>
          <span class="now-label">Summer 2026</span>
          <p class="now-text">Shipping LittleLamb. Interning at CATLab. Writing the argument.</p>
        </div>

        <!-- Ethiopian stripe — the mark -->
        <div class="eth-stripe" role="img" aria-label="Ethiopian flag colors">
          <div class="s-green"></div>
          <div class="s-gold"></div>
          <div class="s-red"></div>
        </div>

        <!-- Direct address -->
        <p class="hero-hi">Hi.</p>
        <h1 class="hero-name">I'm David Melesse.</h1>

        <p class="hero-becoming">Becoming who I am.</p>
        <p class="hero-studying">Studying Computer Science, Data Analytics & Philosophy @ Westmont</p>

        <p class="hero-guide">If you're curious about the thinking — start with the writing.</p>

        <div class="hero-cta">
          <a href="/projects" class="cta-primary">The work →</a>
          <a href="/blog" class="cta-ghost">The writing →</a>
        </div>

      </div>
    </div>

  </section>


  <!-- ═══════ BUILDING ═══════ -->
  <section class="section section-light">
    <div class="inner">
      <p class="section-lede">The things keeping me busy.</p>
      <span class="eyebrow eyebrow-crimson">Currently building</span>
      <div class="project-grid">

        <a href="/projects" class="card card-featured">
          <div class="card-img card-img-logo">
            <img src="/littlelamb.png" alt="LittleLamb Nannies" class="card-img-real" />
          </div>
          <div class="card-body">
            <span class="tag tag-crimson">Startup · React + Firebase</span>
            <h3>LittleLamb Nannies</h3>
            <p>Christ-centered nanny placement for families in Santa Barbara. Values-aligned matching. Built with care.</p>
            <span class="card-link">View project →</span>
          </div>
        </a>

        <div class="card-stack">
          <a href="/projects" class="card card-sm">
            <span class="tag tag-crimson">Internship</span>
            <h3>CATLab SDR</h3>
            <p>Outreach and donor relations at Westmont's applied tech lab. Cold calls, Salesforce, real relationships.</p>
            <span class="card-link">Learn more →</span>
          </a>
          <a href="/blog" class="card card-sm card-dark">
            <span class="tag tag-gold">Writing</span>
            <h3>The Fall of AI</h3>
            <p class="card-subtitle">God's Creation of AI</p>
            <p>At the intersection of AI, philosophy, and the human condition. The ideas are taking shape.</p>
            <span class="card-link">Read the thinking →</span>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════ WRITING ═══════ -->
  <section class="section section-dark">
    <div class="inner">
      <p class="writing-lede">If you want to know how I think, this is the place.</p>
      <div class="writing-head">
        <span class="eyebrow eyebrow-gold">Latest writing</span>
        <a href="/blog" class="see-all">All posts →</a>
      </div>
      <div class="writing-grid">

        <a href="/blog" class="card card-featured card-dark-featured">
          <div class="card-img card-img-book">
            <img src="/book.png" alt="The Fall of AI" class="card-img-book-full" />
          </div>
          <div class="card-body">
            <span class="tag tag-gold">Book · Philosophy</span>
            <h3 class="card-title-dark">The Fall of AI</h3>
            <p class="card-p-dark">God's Creation of AI. At the intersection of artificial intelligence, philosophy, and the human condition. The argument is forming.</p>
            <span class="card-link">Read the thinking →</span>
          </div>
        </a>

        <a href="/blog/sneak-peak" class="sneak-card">
          <div class="sneak-img">
            <img src="/fall-of-ai-cover.png" alt="The Fall of AI — Sneak Peak" class="sneak-img-full" />
            <div class="sneak-overlay"></div>
          </div>
          <div class="sneak-label">
            <span class="sneak-eyebrow">Sneak Peak</span>
          </div>
        </a>

      </div>
    </div>
  </section>


  <!-- ═══════ NOW ═══════ -->
  <section class="section section-medium">
    <div class="inner">
      <div class="quote-block">
        <span class="eyebrow eyebrow-gold">Right now, specifically</span>
        <blockquote>Concept → Execution.</blockquote>
        <p class="quote-sub">
          Shipping LittleLamb before September.
          Interning at CATLab. Writing the argument.
          Drinking too much coffee.
        </p>
        <a href="/now" class="now-full-link">The full picture →</a>
      </div>
    </div>
  </section>


  <!-- ═══════ FOOTER ═══════ -->
  <footer class="footer">
    <div class="inner footer-inner">
      <div class="footer-id">
        <span class="footer-name">David Melesse</span>
        <span class="footer-meta">Westmont College · Class of 2027</span>
      </div>
      <div class="footer-links">
        <a href="mailto:melesse.david11@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
    <div class="inner footer-bottom">
      <span>Built by David Melesse · 2026</span>
    </div>
  </footer>

</Layout>


<style>
  /* ── HERO: SPLIT ── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  /* Photo */
  .hero-photo {
    position: relative;
    overflow: hidden;
    background: #C4B89A;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 8%;
    display: block;
    filter: sepia(0.06) saturate(1.05);
  }
  .photo-fade {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 140px;
    background: linear-gradient(to right, transparent, var(--espresso));
  }

  /* DM logo floats over photo, top-left */
  .logo-float {
    position: absolute;
    top: 2rem;
    left: 2rem;
    z-index: 10;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 10px rgba(17, 10, 6, 0.6);
    transition: color 0.2s;
  }
  .logo:hover { color: var(--gold); }

  /* Text panel */
  .hero-text {
    background: var(--espresso);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem 3rem 4rem;
    position: relative;
  }

  /* Nav: top of text panel */
  .hero-nav {
    display: flex;
    gap: 2rem;
    align-self: flex-start;
  }
  .hero-nav a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.45;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }
  .hero-nav a:hover { opacity: 1; }

  /* Content: bottom of text panel */
  .hero-content { display: flex; flex-direction: column; }

  /* Status card */
  .now-card {
    display: inline-flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--dark-roast);
    border: 1px solid rgba(200, 137, 58, 0.18);
    border-radius: 8px;
    padding: 0.875rem 1.125rem;
    max-width: 265px;
    margin-bottom: 2.5rem;
    align-self: flex-start;
  }
  .now-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #3EA55A;
    box-shadow: 0 0 0 2px rgba(62, 165, 90, 0.28);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(62, 165, 90, 0.28); }
    50%       { box-shadow: 0 0 0 6px rgba(62, 165, 90, 0.06); }
  }
  .now-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .now-text {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    line-height: 1.55;
  }

  /* Ethiopian stripe */
  .eth-stripe {
    display: flex;
    gap: 3px;
    width: 50px;
    margin-bottom: 1.5rem;
  }
  .eth-stripe > div { height: 3px; flex: 1; border-radius: 2px; }
  .s-green { background: var(--eth-green); }
  .s-gold  { background: var(--eth-gold); }
  .s-red   { background: var(--eth-red); }

  .hero-becoming {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--gold-light);
    line-height: 1.3;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .hero-studying {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
    opacity: 0.45;
    letter-spacing: 0.04em;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  /* Name — the 3rd wall break starts here */
  .hero-hi {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    font-style: italic;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 0.375rem;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    color: var(--cream);
    line-height: 1.2;
    margin-bottom: 0;
  }

  /* Bio with hover peeks */
  .hero-bio {
    font-size: 1rem;
    color: var(--text-muted-dark);
    line-height: 1.85;
    margin-bottom: 0.875rem;
  }

  /* ── THE PEEK SYSTEM — hover reveals ── */
  .peek {
    position: relative;
    border-bottom: 1px dashed rgba(200, 137, 58, 0.4);
    cursor: help;
    transition: color 0.15s;
  }
  .peek:hover { color: var(--gold-light); }

  /* Tooltip via CSS attr() — no JS */
  .peek::after {
    content: attr(data-peek);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(5px);
    background: var(--dark-roast);
    border: 1px solid rgba(200, 137, 58, 0.22);
    border-radius: 6px;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 400;
    color: var(--cream);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    z-index: 50;
    transition: opacity 0.2s, transform 0.2s;
  }
  .peek:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Guide line */
  .hero-guide {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted-dark);
    opacity: 0.6;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* CTAs */
  .hero-cta { display: flex; align-items: center; gap: 2rem; }
  .cta-primary {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gold);
    border-bottom: 1px solid rgba(200, 137, 58, 0.35);
    padding-bottom: 3px;
    transition: border-color 0.2s;
  }
  .cta-primary:hover { border-color: var(--gold); }
  .cta-ghost {
    font-size: 0.9375rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .cta-ghost:hover { color: var(--text-on-dark); }

  /* ── SECTIONS ── */
  .section { padding: 6rem 2.5rem; }
  .inner { max-width: var(--max-width); margin: 0 auto; }
  .section-light  { background: var(--cream);        color: var(--text-on-light); }
  .section-dark   { background: var(--espresso);     color: var(--text-on-dark); }
  .section-medium { background: var(--medium-roast); color: var(--text-on-dark); }

  /* Conversational intros */
  .section-lede {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-style: italic;
    color: var(--text-muted-light);
    margin-bottom: 0.5rem;
  }
  .writing-lede {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--text-muted-dark);
    max-width: 480px;
    line-height: 1.4;
    margin-bottom: 2rem;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }
  .eyebrow-crimson { color: var(--crimson); }
  .eyebrow-gold    { color: var(--gold); }

  /* ── PROJECT GRID ── */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .card {
    display: block;
    border-radius: 12px;
    border: 1px solid rgba(30, 16, 10, 0.1);
    background: var(--cream-card);
    transition: transform 0.25s ease, border-color 0.25s ease;
    overflow: hidden;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: rgba(200, 137, 58, 0.4);
  }
  .card-featured { display: flex; flex-direction: column; }
  .card-img {
    height: 200px;
    background: linear-gradient(145deg, #2C180F 0%, #1A0F0A 55%, #3A200F 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .card-img-logo {
    background: #F5F0E8;
    padding: 1.5rem;
  }
  .card-img-real {
    width: auto;
    height: 100%;
    max-height: 130px;
    object-fit: contain;
  }
  .card-body { padding: 1.75rem; }
  .card-sm   { padding: 1.75rem; }
  .card-stack { display: flex; flex-direction: column; gap: 1.5rem; }
  .card-dark {
    background: var(--dark-roast);
    border-color: rgba(200, 137, 58, 0.12);
    color: var(--text-on-dark);
  }
  .card-dark:hover { border-color: rgba(200, 137, 58, 0.35); }
  .card-dark h3 { color: var(--text-on-dark); }
  .card-dark p  { color: var(--text-muted-dark); }

  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .tag-crimson { color: var(--crimson); }
  .tag-gold    { color: var(--gold-light); }

  .card h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-on-light);
    margin-bottom: 0.5rem;
  }
  .card p {
    font-size: 0.9375rem;
    color: var(--text-muted-light);
    line-height: 1.7;
  }
  .card-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--gold-light);
    opacity: 0.7;
    margin-top: -0.25rem;
    margin-bottom: 0.625rem;
  }
  .card-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gold);
    transition: opacity 0.2s;
  }
  .card:hover .card-link { opacity: 0.65; }

  /* ── WRITING ── */
  .writing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .card-dark-featured {
    background: var(--dark-roast);
    border-color: rgba(200, 137, 58, 0.12);
  }
  .card-dark-featured:hover { border-color: rgba(200, 137, 58, 0.35); }
  .card-img-book {
    background: #1A1208;
    padding: 0;
  }
  .card-img-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .card-title-dark { color: var(--text-on-dark) !important; }
  .card-p-dark { color: var(--text-muted-dark) !important; }

  .writing-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .writing-head .eyebrow-gold { margin-bottom: 0; }
  .see-all {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gold);
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .see-all:hover { opacity: 1; }
  .writing-list { border-top: 1px solid rgba(240, 232, 216, 0.1); }
  .writing-empty {
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(240, 232, 216, 0.1);
  }
  .writing-empty p {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--text-muted-dark);
  }
  .writing-item {
    display: block;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(240, 232, 216, 0.1);
    transition: opacity 0.2s;
  }
  .writing-item:hover { opacity: 0.7; }
  .writing-item-date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    color: var(--text-muted-dark);
    opacity: 0.5;
    text-transform: uppercase;
    margin-bottom: 0.375rem;
  }
  .writing-item-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--text-on-dark);
    line-height: 1.25;
    margin-bottom: 0.375rem;
  }
  .writing-item-desc {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    line-height: 1.6;
  }

  /* ── QUOTE / NOW ── */
  .quote-block { max-width: 600px; }
  .quote-block .eyebrow-gold { margin-bottom: 2rem; }
  blockquote {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-style: italic;
    color: var(--gold-light);
    line-height: 1.2;
    border-left: 2px solid var(--gold);
    border-radius: 0;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .quote-sub {
    font-size: 1.0625rem;
    color: var(--text-muted-dark);
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  .now-full-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gold);
    border-bottom: 1px solid rgba(200, 137, 58, 0.3);
    padding-bottom: 3px;
    transition: border-color 0.2s;
  }
  .now-full-link:hover { border-color: var(--gold); }

  /* ── FOOTER ── */
  .footer {
    background: var(--espresso);
    border-top: 1px solid rgba(240, 232, 216, 0.07);
    padding: 3rem 2.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
    margin-bottom: 1.5rem;
  }
  .footer-id { display: flex; flex-direction: column; gap: 0.3rem; }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
  }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cream); }
  .footer-bottom {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(240, 232, 216, 0.2);
  }

  /* ── BOOK IMAGE: full bleed ── */
  .card-img-book-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* ── SNEAK PEAK CARD ── */
  .sneak-card {
    display: block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(200, 137, 58, 0.12);
    transition: border-color 0.25s ease, transform 0.25s ease;
    height: 100%;
    min-height: 300px;
  }
  .sneak-card:hover {
    border-color: rgba(200, 137, 58, 0.4);
    transform: translateY(-3px);
  }
  .sneak-img {
    position: absolute;
    inset: 0;
  }
  .sneak-img-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .sneak-overlay {
    position: absolute;
    inset: 0;
