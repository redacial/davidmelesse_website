---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const categoryLabels: Record<string, string> = {
  ai: 'AI & Technology',
  faith: 'Faith',
  daily: 'Daily Stories',
  conversations: '1-on-1s',
  philosophy: 'Philosophy',
};

const categories = Object.keys(categoryLabels);
---

<Layout title="Writing — David Melesse" description="David Melesse's writing — on AI, faith, humanity, and what they have to do with each other.">

  <header class="page-header">
    <nav class="page-nav">
      <a href="/" class="logo">DM</a>
      <div class="nav-links">
        <a href="/projects">work</a>
        <a href="/blog" class="active">writing</a>
        <a href="/now">now</a>
      </div>
    </nav>
  </header>

  <main>

    <section class="hero-section">
      <div class="inner">
        <div class="eth-stripe" role="img" aria-label="Ethiopian flag colors">
          <div class="s-green"></div>
          <div class="s-gold"></div>
          <div class="s-red"></div>
        </div>
        <p class="page-lede">If you want to know how I think, this is the place.</p>
        <h1 class="page-title">Writing</h1>
        <p class="page-sub">Working out an argument at the intersection of AI, faith, and what it means to be human. One post at a time.</p>
      </div>
    </section>

    <section class="posts-section section-dark">
      <div class="inner">

        <!-- Category filter tabs -->
        <div class="category-tabs" id="category-tabs">
          <button class="tab active" data-category="all">All</button>
          {categories.map(cat => (
            <button class="tab" data-category={cat}>{categoryLabels[cat]}</button>
          ))}
        </div>

        {posts.length === 0 ? (
          <div class="empty-state">
            <p class="empty-main">First post coming.</p>
            <p class="empty-sub">Accumulating the argument.</p>
          </div>
        ) : (
          <ul class="post-list" role="list" id="post-list">
            {posts.map((post) => (
              <li class="post-item" data-category={post.data.category}>
                <a href={`/blog/${post.slug}`} class="post-link">
                  <div class="post-meta">
                    <time class="post-date" datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    <span class="post-category">{categoryLabels[post.data.category ?? 'ai']}</span>
                  </div>
                  <div class="post-content">
                    <h2 class="post-title">{post.data.title}</h2>
                    <p class="post-desc">{post.data.description}</p>
                    <span class="post-arrow">Read →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}

      </div>
    </section>

    <footer class="footer">
      <div class="inner footer-inner">
        <div class="footer-id">
          <span class="footer-name">David Melesse</span>
          <span class="footer-meta">Westmont College · Class of 2027</span>
        </div>
        <div class="footer-links">
          <a href="mailto:melesse.david11@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="inner footer-bottom">
        <span>Built by David Melesse · 2026</span>
      </div>
    </footer>

  </main>

</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const items = document.querySelectorAll<HTMLLIElement>('.post-item');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const cat = tab.dataset.category;
      items.forEach(item => {
        if (cat === 'all' || item.dataset.category === cat) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* ── HEADER ── */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--espresso);
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
  }
  .page-nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .logo:hover { color: var(--gold); }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.4;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }
  .nav-links a:hover, .nav-links a.active { opacity: 1; }

  /* ── HERO ── */
  .hero-section {
    background: var(--espresso);
    padding: 5rem 2.5rem 4rem;
  }
  .inner { max-width: var(--max-width); margin: 0 auto; }

  .eth-stripe {
    display: flex;
    gap: 3px;
    width: 50px;
    margin-bottom: 2rem;
  }
  .eth-stripe > div { height: 3px; flex: 1; border-radius: 2px; }
  .s-green { background: var(--eth-green); }
  .s-gold  { background: var(--eth-gold); }
  .s-red   { background: var(--eth-red); }

  .page-lede {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-muted-dark);
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    color: var(--text-on-dark);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }
  .page-sub {
    font-size: 1.0625rem;
    color: var(--text-muted-dark);
    max-width: 540px;
    line-height: 1.8;
  }

  /* ── CATEGORY TABS ── */
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
    padding-top: 0.5rem;
  }
  .tab {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgba(240, 232, 216, 0.12);
    background: transparent;
    color: var(--text-muted-dark);
    cursor: pointer;
    transition: all 0.2s;
  }
  .tab:hover {
    border-color: rgba(200, 137, 58, 0.4);
    color: var(--gold);
  }
  .tab.active {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--espresso);
  }

  /* ── POSTS ── */
  .section-dark { background: var(--espresso); }
  .posts-section { padding: 4rem 2.5rem 8rem; }

  .empty-state {
    padding: 4rem 0;
    border-top: 1px solid rgba(240, 232, 216, 0.08);
  }
  .empty-main {
    font-family: var(--font-display);
    font-size: 2rem;
    font-style: italic;
    color: var(--text-muted-dark);
    margin-bottom: 0.5rem;
  }
  .empty-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted-dark);
    opacity: 0.5;
    letter-spacing: 0.04em;
  }

  .post-list {
    list-style: none;
    border-top: 1px solid rgba(240, 232, 216, 0.08);
  }
  .post-item {
    border-bottom: 1px solid rgba(240, 232, 216, 0.08);
  }
  .post-link {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2.5rem;
    padding: 2.5rem 0;
    transition: opacity 0.2s;
    align-items: start;
  }
  .post-link:hover { opacity: 0.75; }
  .post-link:hover .post-arrow { opacity: 1; }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
    opacity: 0.6;
    letter-spacing: 0.04em;
    display: block;
  }
  .post-category {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0.7;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    color: var(--text-on-dark);
    line-height: 1.2;
    margin-bottom: 0.625rem;
  }
  .post-desc {
    font-size: 0.9375rem;
    color: var(--text-muted-dark);
    line-height: 1.7;
    margin-bottom: 0.875rem;
    max-width: 560px;
  }
  .post-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gold);
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  /* ── FOOTER ── */
  .footer {
    background: var(--espresso);
    border-top: 1px solid rgba(240, 232, 216, 0.07);
    padding: 3rem 2.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
    margin-bottom: 1.5rem;
  }
  .footer-id { display: flex; flex-direction: column; gap: 0.3rem; }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
  }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cream); }
  .footer-bottom {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(240, 232, 216, 0.2);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .hero-section { padding: 3.5rem 1.5rem 3rem; }
    .posts-section { padding: 3.5rem 1.5rem 6rem; }
    .page-nav { padding: 1rem 1.5rem; }
    .post-link { grid-template-columns: 1fr; gap: 0.5rem; }
    .footer-inner { flex-direction: column; gap: 1.5rem; }
  }
</style>
