---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work — David Melesse" description="Projects David Melesse has built: LittleLamb Nannies, CATLab SDR, and more.">

  <header class="page-header">
    <nav class="page-nav">
      <a href="/" class="logo">DM</a>
      <div class="nav-links">
        <a href="/projects" class="active">work</a>
        <a href="/blog">writing</a>
        <a href="/now">now</a>
      </div>
    </nav>
  </header>

  <main>

    <section class="hero-section">
      <div class="inner">
        <div class="eth-stripe" role="img" aria-label="Ethiopian flag colors">
          <div class="s-green"></div>
          <div class="s-gold"></div>
          <div class="s-red"></div>
        </div>
        <p class="page-lede">The things keeping me busy.</p>
        <h1 class="page-title">Work</h1>
        <p class="page-sub">I build things that matter to real people. Currently focused on LittleLamb and learning everything I can at CATLab.</p>
      </div>
    </section>


    <!-- LittleLamb -->
    <section class="project-section section-light">
      <div class="inner project-layout">

        <div class="project-visual">
          <div class="project-img-wrap project-img-wrap-light">
            <img src="/littlelamb.png" alt="LittleLamb Nannies logo" class="project-img project-img-contain" />
          </div>
          <div class="project-tags">
            <span class="tag tag-crimson">Startup</span>
            <span class="tag tag-dark">React</span>
            <span class="tag tag-dark">Firebase</span>
            <span class="tag tag-dark">TypeScript</span>
          </div>
        </div>

        <div class="project-content">
          <span class="eyebrow eyebrow-crimson">Currently building · 2025–present</span>
          <h2>LittleLamb Nannies</h2>
          <p class="project-desc">
            Christ-centered nanny placement for families in Santa Barbara.
            Not just a matching platform — a values-aligned service that takes
            seriously what it means to trust someone with your children.
          </p>
          <p class="project-desc">
            I'm co-founding this. Building the full product: family onboarding,
            nanny profiles, matching logic, and the trust infrastructure
            underneath it all. Launching before September 2026.
          </p>
          <div class="project-details">
            <div class="detail">
              <span class="detail-label">Role</span>
              <span class="detail-value">Co-founder · Full-stack developer</span>
            </div>
            <div class="detail">
              <span class="detail-label">Stack</span>
              <span class="detail-value">React · TypeScript · Firebase · Tailwind</span>
            </div>
            <div class="detail">
              <span class="detail-label">Status</span>
              <span class="detail-value detail-live">In development — launching Summer 2026</span>
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- CATLab -->
    <section class="project-section section-medium">
      <div class="inner project-layout project-layout-reverse">

        <div class="project-visual">
          <div class="project-img-wrap project-img-wrap-dark">
            <img src="/catlab.png" alt="Westmont CATLab logo" class="project-img project-img-contain" />
          </div>
          <div class="project-tags">
            <span class="tag tag-gold">Internship</span>
            <span class="tag tag-dark-light">Salesforce</span>
            <span class="tag tag-dark-light">SDR</span>
          </div>
        </div>

        <div class="project-content project-content-dark">
          <span class="eyebrow eyebrow-gold">Internship · Summer 2026</span>
          <h2>CATLab — SDR</h2>
          <p class="project-desc project-desc-dark">
            Westmont College's applied technology lab. I'm doing donor and
            outreach relations as a Sales Development Representative —
            cold calls, Salesforce CRM, and building real relationships
            with people who care about the intersection of faith and technology.
          </p>
          <p class="project-desc project-desc-dark">
            The work is less glamorous than shipping features but more
            educational than I expected. You learn what persuasion actually
            is when you have to do it in real time on the phone.
          </p>
          <div class="project-details project-details-dark">
            <div class="detail">
              <span class="detail-label detail-label-dark">Role</span>
              <span class="detail-value detail-value-dark">Sales Development Representative</span>
            </div>
            <div class="detail">
              <span class="detail-label detail-label-dark">Tools</span>
              <span class="detail-value detail-value-dark">Salesforce · HubSpot · Cold outreach</span>
            </div>
            <div class="detail">
              <span class="detail-label detail-label-dark">What I'm learning</span>
              <span class="detail-value detail-value-dark">Relationship-first sales, institutional fundraising</span>
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- The Book -->
    <section class="project-section section-dark">
      <div class="inner project-layout">

        <div class="project-visual">
          <div class="project-img-wrap project-img-wrap-cover">
            <img src="/book.png" alt="AI and humanity — Sistine Chapel reimagined" class="project-img project-img-cover" />
          </div>
          <div class="project-tags">
            <span class="tag tag-gold">Writing</span>
            <span class="tag tag-dark-light">Philosophy</span>
            <span class="tag tag-dark-light">AI</span>
          </div>
        </div>

        <div class="project-content project-content-dark">
          <span class="eyebrow eyebrow-gold">Long project · Ongoing</span>
          <h2>The Book</h2>
          <p class="project-desc project-desc-dark">
            At the intersection of artificial intelligence, philosophy,
            and the human condition. The argument is forming: that what AI
            reveals most clearly is not what machines can do, but what
            it means to be distinctly, irreducibly human.
          </p>
          <p class="project-desc project-desc-dark">
            This is the project behind the writing. The blog is where
            I work out the ideas. The book is where they land.
          </p>
          <div class="project-details project-details-dark">
            <div class="detail">
              <span class="detail-label detail-label-dark">What it is</span>
              <span class="detail-value detail-value-dark">Long-form argument, essay collection</span>
            </div>
            <div class="detail">
              <span class="detail-label detail-label-dark">Themes</span>
              <span class="detail-value detail-value-dark">AI · Personhood · Faith · Creativity</span>
            </div>
          </div>
          <a href="/blog" class="project-cta">Read the early thinking →</a>
        </div>

      </div>
    </section>


    <!-- Footer -->
    <footer class="footer">
      <div class="inner footer-inner">
        <div class="footer-id">
          <span class="footer-name">David Melesse</span>
          <span class="footer-meta">Westmont College · Class of 2027</span>
        </div>
        <div class="footer-links">
          <a href="mailto:melesse.david11@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="inner footer-bottom">
        <span>Built by David Melesse · 2026</span>
      </div>
    </footer>

  </main>

</Layout>


<style>
  /* ── HEADER / NAV ── */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--espresso);
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
  }
  .page-nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .logo:hover { color: var(--gold); }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.4;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }
  .nav-links a:hover, .nav-links a.active { opacity: 1; }

  /* ── HERO SECTION ── */
  .hero-section {
    background: var(--espresso);
    padding: 6rem 2.5rem 5rem;
  }
  .inner { max-width: var(--max-width); margin: 0 auto; }

  .eth-stripe {
    display: flex;
    gap: 3px;
    width: 50px;
    margin-bottom: 2rem;
  }
  .eth-stripe > div { height: 3px; flex: 1; border-radius: 2px; }
  .s-green { background: var(--eth-green); }
  .s-gold  { background: var(--eth-gold); }
  .s-red   { background: var(--eth-red); }

  .page-lede {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-muted-dark);
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    color: var(--text-on-dark);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }
  .page-sub {
    font-size: 1.0625rem;
    color: var(--text-muted-dark);
    max-width: 560px;
    line-height: 1.8;
  }

  /* ── PROJECT SECTIONS ── */
  .project-section { padding: 6rem 2.5rem; }
  .section-light  { background: var(--cream); }
  .section-medium { background: var(--medium-roast); }
  .section-dark   { background: var(--espresso); }

  .project-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .project-layout-reverse { direction: rtl; }
  .project-layout-reverse > * { direction: ltr; }

  /* Visual */
  .project-visual { display: flex; flex-direction: column; gap: 1.25rem; }

  .project-img-wrap {
    aspect-ratio: 4/3;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
  }
  .project-img-wrap-light {
    background: #F5F0E8;
  }
  .project-img-wrap-dark {
    background: var(--dark-roast);
  }
  .project-img-wrap-cover {
    background: #1A1208;
    padding: 0;
  }
  .project-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }
  .project-img-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    image-rendering: auto;
  }

  .project-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 4px;
  }
  .tag-crimson { color: var(--crimson); border: 1px solid rgba(122, 30, 40, 0.3); background: rgba(122, 30, 40, 0.08); }
  .tag-gold    { color: var(--gold-light); border: 1px solid rgba(200, 137, 58, 0.3); background: rgba(200, 137, 58, 0.08); }
  .tag-dark    { color: var(--text-muted-light); border: 1px solid rgba(30, 16, 10, 0.15); }
  .tag-dark-light { color: var(--text-muted-dark); border: 1px solid rgba(240, 232, 216, 0.15); }

  /* Project text content */
  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .eyebrow-crimson { color: var(--crimson); }
  .eyebrow-gold    { color: var(--gold); }

  .project-content h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    color: var(--text-on-light);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .project-content-dark h2 { color: var(--text-on-dark); }

  .project-desc {
    font-size: 1rem;
    color: var(--text-muted-light);
    line-height: 1.85;
    margin-bottom: 1rem;
  }
  .project-desc:last-of-type { margin-bottom: 2rem; }
  .project-desc-dark { color: var(--text-muted-dark); }

  .project-details {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-top: 1px solid rgba(30, 16, 10, 0.1);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }
  .project-details-dark { border-top-color: rgba(240, 232, 216, 0.1); }

  .detail { display: flex; gap: 1rem; align-items: baseline; }
  .detail-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted-light);
    min-width: 80px;
    flex-shrink: 0;
  }
  .detail-label-dark { color: var(--text-muted-dark); opacity: 0.6; }
  .detail-value {
    font-size: 0.9375rem;
    color: var(--text-on-light);
  }
  .detail-value-dark { color: var(--text-muted-dark); }
  .detail-live { color: var(--eth-green); }

  .project-cta {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gold);
    border-bottom: 1px solid rgba(200, 137, 58, 0.3);
    padding-bottom: 3px;
    transition: border-color 0.2s;
  }
  .project-cta:hover { border-color: var(--gold); }

  /* ── FOOTER ── */
  .footer {
    background: var(--espresso);
    border-top: 1px solid rgba(240, 232, 216, 0.07);
    padding: 3rem 2.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
    margin-bottom: 1.5rem;
  }
  .footer-id { display: flex; flex-direction: column; gap: 0.3rem; }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
  }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cream); }
  .footer-bottom {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: rgba(240, 232, 216, 0.2);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .project-layout-reverse { direction: ltr; }
  }
  @media (max-width: 640px) {
    .hero-section { padding: 4rem 1.5rem 3rem; }
    .project-section { padding: 4rem 1.5rem; }
    .page-nav { padding: 1rem 1.5rem; }
    .footer-inner { flex-direction: column; gap: 1.5rem; }
  }
</style>
