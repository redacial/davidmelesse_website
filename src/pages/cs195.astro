---
import Layout from '../layouts/Layout.astro';

type Item = {
  title: string;
  status: 'Submitted' | 'In progress' | 'Upcoming';
  href?: string;
  note?: string;
};

// Official copies of written work live in Google Docs; this page points to them.
const groups: { label: string; eyebrow: string; items: Item[] }[] = [
  {
    label: 'Capstone project',
    eyebrow: 'Building',
    items: [
      { title: 'Project Idea Elevator Pitch', status: 'Upcoming' },
      { title: 'Project Proposal', status: 'Upcoming' },
      { title: 'User Flow Diagram', status: 'Upcoming' },
      { title: 'Alpha Release', status: 'Upcoming' },
      { title: 'Beta Release', status: 'Upcoming' },
      { title: 'Release Candidate', status: 'Upcoming' },
      { title: 'Final Presentation', status: 'Upcoming' },
    ],
  },
  {
    label: 'Ἀπολογητικὴ ψυχαγωγία',
    eyebrow: 'Writing',
    items: [
      { title: 'AP I', status: 'Upcoming' },
      { title: 'AP II', status: 'Upcoming' },
      { title: 'AP III', status: 'Upcoming' },
      { title: 'AP IV — The AI Mirror', status: 'Upcoming' },
      { title: 'AP V — Empire of AI', status: 'Upcoming' },
      { title: 'AP VI — Impact Players', status: 'Upcoming' },
      { title: 'AP VII — Stewards of Eden', status: 'Upcoming' },
      { title: 'AP VIII — Minds, Brains and Science', status: 'Upcoming' },
    ],
  },
  {
    label: 'Professional development',
    eyebrow: 'Career',
    items: [
      { title: 'Résumé', status: 'In progress', note: 'Draft submitted' },
      { title: 'Personal Core Values', status: 'Upcoming' },
      { title: 'Organization Research', status: 'Upcoming' },
      { title: 'Cover Letter', status: 'Upcoming' },
    ],
  },
];

const statusClass = {
  'Submitted': 'status-done',
  'In progress': 'status-progress',
  'Upcoming': 'status-upcoming',
} as const;
---

<Layout title="CS 195 — David Melesse" description="David Melesse's work for CS 195, the Computer Science and Data Analytics Senior Seminar at Westmont College.">

  <header class="page-header">
    <nav class="page-nav">
      <a href="/" class="logo">DM</a>
      <div class="nav-links">
        <a href="/projects">Work</a>
        <a href="/blog">Writing</a>
        <a href="/cs195" class="active">CS 195</a>
        <a href="/now">Now</a>
      </div>
    </nav>
  </header>

  <main>

    <section class="hero-section">
      <div class="inner">
        <div class="eth-stripe" role="img" aria-label="Ethiopian flag colors">
          <div class="s-green"></div>
          <div class="s-gold"></div>
          <div class="s-red"></div>
        </div>
        <p class="page-lede">Senior seminar, in public.</p>
        <h1 class="page-title">CS 195</h1>
        <p class="page-sub">
          Computer Science and Data Analytics Senior Seminar at Westmont, Fall 2026.
          A capstone build, essays on what technology does to us, and getting ready
          for life after college. This page tracks the work as it happens.
        </p>
      </div>
    </section>

    <section class="work-section section-light">
      <div class="inner work-grid">
        {groups.map((group) => (
          <div class="work-group">
            <span class="eyebrow">{group.eyebrow}</span>
            <h2>{group.label}</h2>
            <ul class="work-list">
              {group.items.map((item) => (
                <li class="work-item">
                  {item.href ? (
                    <a href={item.href} target="_blank" rel="noopener noreferrer" class="work-title work-link">{item.title} →</a>
                  ) : (
                    <span class="work-title">{item.title}</span>
                  )}
                  <span class={`work-status ${statusClass[item.status]}`}>{item.note ?? item.status}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <footer class="footer">
      <div class="inner footer-inner">
        <div class="footer-id">
          <span class="footer-name">David Melesse</span>
          <span class="footer-meta">Westmont College · Class of 2027</span>
        </div>
        <div class="footer-links">
          <a href="mailto:melesse.david11@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/david-melesse-ba0166287/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/redacial" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="inner footer-bottom">
        <span>Built by David Melesse · 2026</span>
      </div>
    </footer>

  </main>

</Layout>


<style>
  /* ── HEADER / NAV ── */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--espresso);
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
  }
  .page-nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .logo:hover { color: var(--gold); }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-on-dark);
    opacity: 0.7;
    letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }
  .nav-links a:hover, .nav-links a.active { opacity: 1; }

  /* ── HERO SECTION ── */
  .hero-section {
    background: var(--espresso);
    padding: 6rem 2.5rem 5rem;
  }
  .inner { max-width: var(--max-width); margin: 0 auto; }

  .eth-stripe {
    display: flex;
    gap: 3px;
    width: 50px;
    margin-bottom: 2rem;
  }
  .eth-stripe > div { height: 3px; flex: 1; border-radius: 2px; }
  .s-green { background: var(--eth-green); }
  .s-gold  { background: var(--eth-gold); }
  .s-red   { background: var(--eth-red); }

  .page-lede {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--text-muted-dark);
    margin-bottom: 0.5rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    color: var(--text-on-dark);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }
  .page-sub {
    font-size: 1.0625rem;
    color: var(--text-muted-dark);
    max-width: 560px;
    line-height: 1.8;
  }

  /* ── WORK SECTION ── */
  .work-section { padding: 6rem 2.5rem; }
  .section-light { background: var(--cream); }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
    align-items: start;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-bottom: 1rem;
  }
  .work-group h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 400;
    color: var(--text-on-light);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .work-list {
    list-style: none;
    border-top: 1px solid rgba(30, 16, 10, 0.1);
  }
  .work-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(30, 16, 10, 0.1);
  }
  .work-title {
    font-size: 0.9375rem;
    color: var(--text-on-light);
  }
  .work-link { color: var(--gold-deep); transition: color 0.2s; }
  .work-link:hover { color: var(--crimson); }

  .work-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* darker than --eth-green: 4.36:1 on cream misses AA for this text size */
  .status-done     { color: #256631; }
  .status-progress { color: var(--gold-deep); }
  .status-upcoming { color: var(--text-muted-light); }

  /* ── FOOTER ── */
  .footer {
    background: var(--espresso);
    border-top: 1px solid rgba(240, 232, 216, 0.07);
    padding: 3rem 2.5rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 232, 216, 0.07);
    margin-bottom: 1.5rem;
  }
  .footer-id { display: flex; flex-direction: column; gap: 0.3rem; }
  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--cream);
  }
  .footer-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted-dark);
  }
  .footer-links { display: flex; gap: 2rem; }
  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-muted-dark);
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--cream); }
  .footer-bottom {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint-dark);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .work-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 640px) {
    .hero-section { padding: 4rem 1.5rem 3rem; }
    .work-section { padding: 4rem 1.5rem; }
    .page-nav { padding: 1rem 1.5rem; }
    .nav-links { gap: 1.25rem; }
    .footer-inner { flex-direction: column; gap: 1.5rem; }
  }
</style>
